<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>내역 수정 - 미니 가계부</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="container container-narrow">
    <header class="page-header">
      <div>
        <h1>거래 내역 수정</h1>
        <p class="subtitle">등록된 수입/지출 정보를 수정합니다.</p>
      </div>
      <a class="btn btn-secondary" href="/?month=<%= encodeURIComponent(returnMonth) %>">목록으로</a>
    </header>

    <% if (error) { %>
      <div class="alert alert-error" role="alert"><%= error %></div>
    <% } %>

    <section class="card">
      <form action="/transactions/<%= transaction.id %>/update" method="POST" class="tx-form">
        <input type="hidden" name="return_month" value="<%= returnMonth %>" />

        <div class="form-row">
          <label>구분</label>
          <div class="radio-group">
            <label class="radio-pill">
              <input type="radio" name="type" value="지출" <%= transaction.type === '지출' ? 'checked' : '' %> />
              <span>지출</span>
            </label>
            <label class="radio-pill">
              <input type="radio" name="type" value="수입" <%= transaction.type === '수입' ? 'checked' : '' %> />
              <span>수입</span>
            </label>
          </div>
        </div>

        <div class="form-row">
          <label for="category">카테고리</label>
          <select id="category" name="category" required>
            <% const initialList = categoriesByType[transaction.type] || categoriesByType['지출']; %>
            <% if (transaction.category && !initialList.includes(transaction.category)) { %>
              <option value="<%= transaction.category %>" selected><%= transaction.category %></option>
            <% } %>
            <% initialList.forEach((cat) => { %>
              <option value="<%= cat %>" <%= transaction.category === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-row">
          <label for="amount">금액 (원)</label>
          <input
            id="amount"
            type="number"
            name="amount"
            min="1"
            step="1"
            value="<%= transaction.amount %>"
            required
          />
        </div>

        <div class="form-row">
          <label for="trans_date">날짜</label>
          <input
            id="trans_date"
            type="date"
            name="trans_date"
            value="<%= transaction.trans_date %>"
            required
          />
        </div>

        <div class="form-row">
          <label for="description">내용</label>
          <input
            id="description"
            type="text"
            name="description"
            maxlength="255"
            value="<%= transaction.description %>"
          />
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">수정 저장</button>
          <a class="btn btn-secondary" href="/?month=<%= encodeURIComponent(returnMonth) %>">취소</a>
        </div>
      </form>
    </section>
  </div>

  <script>
    const categoriesByType = <%- JSON.stringify(categoriesByType).replace(/</g, '\\u003c') %>;
    const typeInputs = document.querySelectorAll('input[name="type"]');
    const categorySelect = document.getElementById('category');
    const currentCategory = <%- JSON.stringify(transaction.category || '').replace(/</g, '\\u003c') %>;
    const initialType = <%- JSON.stringify(transaction.type || '지출').replace(/</g, '\\u003c') %>;

    function syncCategories(type) {
      const options = categoriesByType[type] || [];
      categorySelect.innerHTML = '';
      if (currentCategory && !options.includes(currentCategory) && type === initialType) {
        const customOpt = document.createElement('option');
        customOpt.value = currentCategory;
        customOpt.textContent = currentCategory;
        customOpt.selected = true;
        categorySelect.appendChild(customOpt);
      }
      options.forEach((cat) => {
        const option = document.createElement('option');
        option.value = cat;
        option.textContent = cat;
        if (cat === currentCategory) {
          option.selected = true;
        }
        categorySelect.appendChild(option);
      });
    }

    typeInputs.forEach((input) => {
      input.addEventListener('change', (e) => {
        syncCategories(e.target.value);
      });
    });
  </script>
</body>
</html>
